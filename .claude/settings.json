{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "mcp__receitas__status",
      "mcp__receitas__ajuda",
      "mcp__receitas__fotos",
      "mcp__receitas__logs"
    ],
    "ask": [
      "mcp__receitas__espelho",
      "mcp__receitas__backup",
      "mcp__receitas__reiniciar",
      "mcp__receitas__atualizar_oraculo",
      "mcp__receitas__atualizar_miner",
      "mcp__receitas__desfazer",
      "mcp__receitas__parar_jarvis",
      "mcp__receitas__ligar_jarvis",
      "Edit(/CLAUDE.md)",
      "mcp__hostinger-api"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(sudo)",
      "Read(~/.ssh/**)",
      "Read(~/.config/jarvis/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude/channels/telegram/.env)",
      "Read(//opt/oraculo/**)",
      "Read(//opt/miner/**)",
      "Read(//opt/miner-backups/**)",
      "Read(//var/lib/oraculo/**)",
      "Read(//var/lib/jarvis/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/configuracoes.json)",
      "Read(**/config.json)",
      "Edit(/30-conhecimento/raw/**)",
      "Edit(/50-jarvis/sistema/vps/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.gitignore)",
      "Bash(printenv*)",
      "Bash(env)",
      "mcp__hostinger-api__billing_*",
      "Edit(/.git/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.config/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.local/**)",
      "Edit(~/.bun/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gitconfig)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Edit(~/.claude.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/inicio-sessao.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-edicao.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/autocommit.sh"
          }
        ]
      }
    ]
  }
}

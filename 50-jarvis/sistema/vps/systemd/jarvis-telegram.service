[Unit]
Description=Jarvis: sessão com o canal do Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=jarvis
Group=jarvis
Environment=HOME=/home/jarvis
WorkingDirectory=/home/jarvis/JARVIS
ExecStart=/usr/bin/tmux -L jarvis-telegram new-session -d -s jarvis /opt/jarvis/bin/telegram.sh
ExecStop=/usr/bin/tmux -L jarvis-telegram kill-server
Restart=on-failure
RestartSec=30
Nice=10
MemoryHigh=2G
MemoryMax=2560M

[Install]
WantedBy=multi-user.target
